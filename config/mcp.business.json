{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "closelly-business": {
      "type": "http",
      "url": "https://auth.closelly.com/mcp/business",
      "auth": {
        "type": "oauth",
        "login": "https://auth.closelly.com/oauth/login",
        "protectedResourceMetadata": "https://auth.closelly.com/.well-known/oauth-protected-resource/mcp/business",
        "authorizationServerMetadata": "https://auth.closelly.com/.well-known/oauth-authorization-server/mcp/business"
      },
      "audience": "client-tenant",
      "skill": "mcp-business",
      "notes": [
        "OAuth de User (email + password). No uses InternalCredential.",
        "El tenant sale del token; no pases business_id de otro negocio.",
        "Requiere business.mcp_enabled = true.",
        "Claude Code y ChatGPT/Codex usan la misma URL/OAuth; ChatGPT/Codex vía DCR en extensions.com.openai.auth.",
        "No uses InternalCredential."
      ],
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://auth.closelly.com/mcp/business",
            "authorizationServerBase": "https://auth.closelly.com",
            "baseScopes": [
              "mcp.clients.students.read",
              "mcp.clients.progress.read",
              "mcp.clients.reports.read",
              "mcp.clients.export"
            ]
          }
        }
      }
    }
  }
}
