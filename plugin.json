{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "closelly-ai-plugins",
  "version": "1.1.0",
  "description": "Fuente única, versionada y portable de plugins y skills de Closelly compatible con ChatGPT/Codex, Claude Code y GitHub Copilot CLI.",
  "author": {
    "name": "Closelly Edutech SpA",
    "url": "https://closelly.com"
  },
  "homepage": "https://github.com/Closelly/ai_plugins",
  "repository": "https://github.com/Closelly/ai_plugins",
  "license": "MIT",
  "keywords": [
    "closelly",
    "skills",
    "mcp",
    "chatgpt",
    "codex",
    "claude-code",
    "github-copilot"
  ],
  "extensions": {
    "com.closelly.mcp": {
      "business": {
        "name": "closelly-business",
        "url": "https://auth.closelly.com/mcp/business",
        "transport": "http",
        "auth": "oauth",
        "skill": "mcp-business",
        "config": "./config/mcp.business.json"
      },
      "remote": {
        "enabled": false,
        "status": "documented-oauth-not-auto-activated",
        "reason": "MCP Business está documentado con OAuth; no se auto-activa mcp.json para exigir consentimiento del usuario.",
        "exampleConfig": "./config/mcp.business.json"
      }
    }
  }
}
